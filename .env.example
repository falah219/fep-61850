# Contoh konfigurasi LOKAL/DEV. Salin ke .env (tidak di-commit). Jangan isi kredensial produksi.
POSTGRE_HOST=host.docker.internal
POSTGRE_PORT=5432
DB_USERNAME=postgres
DB_PASSWORD=
DB_DATABASE=ICONICS_DEV

BOOTSTRAP_SERVER=host.docker.internal:9092
SECURITY_PROTOCOL=PLAINTEXT
# Hanya jika SECURITY_PROTOCOL mengandung SASL:
# SASL_MECANISM=PLAIN
# SASL_USERNAME=
# SASL_PASSWORD=
CLIENT_ID=iec61850_client

# Kirim ulang semua nilai polling tiap periode ini (ms)
INTEGRITY_PERIOD_MS=60000
RUST_LOG=info
