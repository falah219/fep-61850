# Contoh konfigurasi LOKAL/DEV. Salin ke .env (tidak di-commit). Jangan isi kredensial produksi.
POSTGRE_HOST=host.docker.internal
POSTGRE_PORT=5432
DB_USERNAME=postgres
DB_PASSWORD=
DB_DATABASE=ICONICS_DEV

BOOTSTRAP_SERVER=host.docker.internal:9092
SECURITY_PROTOCOL=PLAINTEXT
# Hanya jika SECURITY_PROTOCOL mengandung SASL:
# SASL_MECANISM=PLAIN
# SASL_USERNAME=
# SASL_PASSWORD=
CLIENT_ID=iec61850_client
# HARUS beda dengan FEP IEC 104 supaya kedua FEP menerima semua pesan
GROUP_ID=IEC61850_GROUP
AUTO_OFFSET_RESET=latest
SUBSCRIBE_TOPICS=RTU_EVENTS,RTU_COMMAND_CONFIG_REQUEST,MASTER_DATAPOINT_EVENT,MASTER_DATA_OBJECT_EVENT,CAPTURE_DATA_CHANGE,MASTER_RTU_EVENTS,MANUAL_SET_EVENT

# Runtime (nama & default sama dengan FEP IEC 104)
# Maks percobaan konek MMS serentak. Sengaja kecil (FEP IEC 104 memakai 200): banyak connect
# serentak di libIEC61850 bisa menghasilkan koneksi mati yang getState()-nya tetap CONNECTED,
# sehingga IED terlihat online tapi RCB tidak pernah aktif. Lihat docs/CATATAN_TERBUKA.md.
MAX_CONCURRENT_CONNECTS=4
STATUS_HEARTBEAT_INTERVAL_SECS=10
PING_INTERVAL_MS=5000
PING_TIMEOUT_MS=2000
PING_ATTEMPTS=3
PING_RETRY_DELAY_MS=200
PING_RESEND_EVERY=6
PING_CONCURRENCY=500

# Kirim ulang semua nilai polling tiap periode ini (ms)
INTEGRITY_PERIOD_MS=60000
RCB_RETRY_SECS=30
RELOAD_DEBOUNCE_MS=2000
BRCB_RESV_TMS_SECS=20
# Tanpa request sukses / report selama ini (detik) -> baca LLN0.Mod.stVal; gagal -> reconnect
LIVENESS_SECS=30
OPER_TIMEOUT_MS=10000
SHUTDOWN_WAIT_SECS=5
# none | local | remote (lihat docs/CATATAN_TERBUKA.md)
OSI_PARAMS_SIDE=none
RUST_LOG=info
# Log ke file harian logs/iec61850.YYYY-MM-DD selain console (true|false)
LOG_TO_FILE=true
# Jumlah file log harian yang disimpan; lebih lama dihapus. 0 = tanpa batas
LOG_MAX_FILES=14
