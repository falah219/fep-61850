# Satu Dockerfile, tiga stage:
#   libiec61850 : build library + contoh server (dipakai bersama)
#   dev         : toolchain Rust untuk build FEP (fase 2+)
#   ied-sim     : image kecil berisi simulator IED

FROM debian:bookworm-slim AS libiec61850
RUN apt-get update && apt-get install -y --no-install-recommends \
        build-essential cmake \
    && rm -rf /var/lib/apt/lists/*
# libIEC61850 v1.6.2.1 dari source di repo (native/libiec61850, lihat THIRD_PARTY_NOTICES.md),
# tanpa unduh dari internet. Contoh yang ikut hanya simulator (basic_io) + mms_utility.
COPY native/libiec61850 /src
RUN cmake -S /src -B /src/build -DCMAKE_BUILD_TYPE=Release -DBUILD_EXAMPLES=ON -DBUILD_TESTS=OFF -DCMAKE_INSTALL_PREFIX=/usr/local \
    && cmake --build /src/build -j"$(nproc)" \
    && cmake --install /src/build \
    && cp /src/build/examples/server_example_basic_io/server_example_basic_io /usr/local/bin/ied-sim \
    && cp /src/build/examples/mms_utility/mms_utility /usr/local/bin/mms_utility

FROM rust:slim-bookworm AS dev
RUN apt-get update && apt-get install -y --no-install-recommends \
        build-essential cmake clang libclang-dev pkg-config libssl-dev libsasl2-dev \
    && rm -rf /var/lib/apt/lists/* \
    && rustup component add clippy rustfmt
COPY --from=libiec61850 /usr/local/lib/ /usr/local/lib/
COPY --from=libiec61850 /usr/local/include/libiec61850 /usr/local/include/libiec61850
COPY --from=libiec61850 /usr/local/bin/mms_utility /usr/local/bin/
# Contoh file SCL simulator (untuk uji scl-import, fase 10)
COPY --from=libiec61850 /src/examples/server_example_basic_io/simpleIO_direct_control.cid /usr/local/share/libiec61850/
WORKDIR /work

FROM debian:bookworm-slim AS ied-sim
COPY --from=libiec61850 /usr/local/bin/ied-sim /usr/local/bin/mms_utility /usr/local/bin/
EXPOSE 102
# Port MMS bisa diganti lewat argumen pertama (dipakai untuk banyak instance)
ENTRYPOINT ["ied-sim"]
CMD ["102"]
